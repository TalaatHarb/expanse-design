<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.8</version>
        <relativePath/>
    </parent>
    <groupId>net.talaatharb</groupId>
    <artifactId>expanse-design</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Expanse Design</name>
    <description>Local-first, AI-accessible electronic design workbench</description>
    <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>
    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.9</javafx.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <mcp.version>0.17.0</mcp.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <expanse.source-revision>development</expanse.source-revision>
    </properties>
    <modules>
        <module>expanse-domain</module>
        <module>expanse-dto</module>
        <module>expanse-library</module>
        <module>expanse-schematic</module>
        <module>expanse-validation</module>
        <module>expanse-simulation</module>
        <module>expanse-pcb</module>
        <module>expanse-assembly</module>
        <module>expanse-application</module>
        <module>expanse-persistence</module>
        <module>expanse-api</module>
        <module>expanse-api-web</module>
        <module>expanse-connector</module>
        <module>expanse-server</module>
        <module>expanse-desktop</module>
        <module>expanse-mcp</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.9.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
                <executions><execution><id>toolchain</id><goals><goal>enforce</goal></goals>
                    <configuration><rules>
                        <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                        <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                    </rules></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
                <configuration><archive>
                    <manifest><addDefaultImplementationEntries>true</addDefaultImplementationEntries></manifest>
                    <manifestEntries><Source-Revision>${expanse.source-revision}</Source-Revision></manifestEntries>
                </archive></configuration>
            </plugin>
        </plugins>
    </build>
</project>
