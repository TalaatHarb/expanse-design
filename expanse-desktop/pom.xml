<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>net.talaatharb</groupId><artifactId>expanse-design</artifactId><version>0.1.0-SNAPSHOT</version></parent>
    <artifactId>expanse-desktop</artifactId>
    <dependencies>
        <dependency><groupId>net.talaatharb</groupId><artifactId>expanse-connector</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
            <executions><execution><id>client-boundary</id><goals><goal>enforce</goal></goals>
                <configuration><rules><bannedDependencies><excludes>
                    <exclude>net.talaatharb:expanse-domain</exclude>
                    <exclude>net.talaatharb:expanse-application</exclude>
                    <exclude>net.talaatharb:expanse-persistence</exclude>
                    <exclude>net.talaatharb:expanse-api-web</exclude>
                    <exclude>net.talaatharb:expanse-server</exclude>
                    <exclude>net.talaatharb:expanse-library</exclude>
                    <exclude>net.talaatharb:expanse-schematic</exclude>
                    <exclude>net.talaatharb:expanse-validation</exclude>
                    <exclude>net.talaatharb:expanse-simulation</exclude>
                    <exclude>net.talaatharb:expanse-pcb</exclude>
                    <exclude>net.talaatharb:expanse-assembly</exclude>
                </excludes></bannedDependencies></rules></configuration>
            </execution></executions>
        </plugin>
        <plugin><groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId>
            <configuration><mainClass>net.talaatharb.expanse.desktop.DesktopLauncher</mainClass><runtimePathOption>CLASSPATH</runtimePathOption></configuration>
        </plugin>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
            <configuration><mainClass>net.talaatharb.expanse.desktop.DesktopLauncher</mainClass></configuration>
        </plugin>
    </plugins></build>
    <profiles>
        <!-- Release packaging: embeds the expanse-server boot jar so one desktop jar runs client + local server.
             Build it in the same reactor, e.g. mvn -Pbundle-local-server -pl expanse-server,expanse-desktop -am package -->
        <profile>
            <id>bundle-local-server</id>
            <build><plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
                    <executions><execution><id>embed-local-server</id><phase>prepare-package</phase><goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems><artifactItem>
                                <groupId>net.talaatharb</groupId><artifactId>expanse-server</artifactId>
                                <version>${project.version}</version><destFileName>expanse-server.jar</destFileName>
                            </artifactItem></artifactItems>
                            <outputDirectory>${project.build.outputDirectory}/local-server</outputDirectory>
                        </configuration>
                    </execution></executions>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
